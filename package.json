{
  "name": "deskframe",
  "version": "0.1.0",
  "description": "A private desk companion for study sessions, movement breaks and posture research.",
  "author": "Deskframe contributors",
  "main": "desktop/main.mjs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run desktop",
    "start": "npm run desktop",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "desktop": "npm run build && electron .",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "pack:win": "npm run build && electron-builder --dir --win --x64 --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "onnxruntime-web": "1.31.1",
    "playwright-core": "1.65.1"
  }
}
